server {
    listen 80;
    server_name _;
    server_tokens off;
    client_max_body_size 12m;

    # Chỉ media công khai được phục vụ ở đây, vault không được mount vào Nginx.
    location /media/ {
        alias /srv/media/;
        autoindex off;
        add_header X-Content-Type-Options nosniff always;
    }
    location /private_vault/ { return 404; }

    location / {
        proxy_pass http://web:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        # Giá trị cấu hình cố định http/https; không lấy header do client gửi.
        proxy_set_header X-Forwarded-Proto ${PROXY_SCHEME};
        proxy_set_header Connection "";
        proxy_read_timeout 65s;
        proxy_redirect off;
    }
}
