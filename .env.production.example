# Copy thành .env.production; không commit file có giá trị thật.
KMG_ENV=prod
ALLOW_DEMO_SEED=False
# Sinh riêng từng khóa bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
CERT_SIGNING_KEY=
CHAT_MASTER_KEK=
DB_ENGINE=mysql
DB_NAME=kmg_prod
DB_USER=kmg
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_ROOT_PASSWORD=

# Mặc định chỉ mở HTTP trên loopback để kiểm tra trước khi gắn HTTPS.
ALLOWED_HOSTS=localhost,127.0.0.1
HEALTHCHECK_HOST=localhost
SITE_URL=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
PROXY_SCHEME=http
USE_HTTPS=False
# Sau khi có TLS terminator tin cậy: PROXY_SCHEME=https, USE_HTTPS=True,
# SITE_URL=https://<domain>, CSRF_TRUSTED_ORIGINS=https://<domain>, thêm domain vào ALLOWED_HOSTS.
SECURE_HSTS_SECONDS=3600
WEB_CONCURRENCY=2
SCHEDULER_INTERVAL_SECONDS=900

# Điền SMTP/SMS trước khi cho người dùng thật đăng ký.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=KMG Club <no-reply@example.com>
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_API_KEY=
SMS_SENDER_ID=KMG-CLUB

AI_API_KEY=
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
