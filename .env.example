# Mẫu file cấu hình. Copy thành .env rồi sửa cho khớp máy mình.
#     cp .env.example .env
#
# KHÔNG commit file .env lên Git (đã chặn trong .gitignore).

# --- Django ---
DEBUG=True
SECRET_KEY=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai
ALLOWED_HOSTS=*

# --- Cơ sở dữ liệu ---
# mysql    - máy dev và lúc demo (mặc định)
# postgres - host free thường chỉ có Postgres
# sqlite   - chạy nhanh không cần cài gì, dùng cho frontend và unit test
#
# Đừng dùng sqlite khi demo: nó khoá cả file DB chứ không khoá theo dòng,
# nên không thể hiện đúng cơ chế chống race condition khi đặt vé.
DB_ENGINE=mysql
DB_NAME=clubevent
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Một số host (Render, Fly...) cấp sẵn một biến DATABASE_URL gộp cả 5 thông
# tin trên. Điền vào đây thì settings.py tự dùng nó và bỏ qua các biến rời.
# DATABASE_URL=postgres://user:pass@host:5432/tendb

# --- Tích hợp AI (không bắt buộc) ---
# Để trống AI_API_KEY thì hệ thống dùng danh sách công việc mặc định.
# AI_PROVIDER: gemini | openai | mock
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=20

# --- Chỉ khi deploy có HTTPS thật ---
# Bật khi chưa có SSL sẽ làm site không vào được.
USE_HTTPS=False
