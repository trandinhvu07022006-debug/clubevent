# Mẫu file cấu hình. Copy thành .env rồi sửa cho khớp máy mình.
#     cp .env.example .env
#
# KHÔNG commit file .env lên Git (đã chặn trong .gitignore).

# --- Django ---
DEBUG=True
SECRET_KEY=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai
ALLOWED_HOSTS=*
# Tên miền HTTPS được phép gửi form, cách nhau dấu phẩy (ngrok, host thật)
# Ví dụ: CSRF_TRUSTED_ORIGINS=https://abc.ngrok-free.app
CSRF_TRUSTED_ORIGINS=

# --- Cơ sở dữ liệu ---
# mysql    - máy dev và lúc demo (mặc định)
# postgres - host free thường chỉ có Postgres
# sqlite   - chạy nhanh không cần cài gì, dùng cho frontend và unit test
#
# Đừng dùng sqlite khi demo: nó khoá cả file DB chứ không khoá theo dòng,
# nên không thể hiện đúng cơ chế chống race condition khi đặt vé.
DB_ENGINE=mysql
DB_NAME=clubevent
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Một số host (Render, Fly...) cấp sẵn một biến DATABASE_URL gộp cả 5 thông
# tin trên. Điền vào đây thì settings.py tự dùng nó và bỏ qua các biến rời.
# DATABASE_URL=postgres://user:pass@host:5432/tendb

# --- Tích hợp AI (không bắt buộc) ---
# Để trống AI_API_KEY thì hệ thống dùng danh sách công việc mặc định.
# AI_PROVIDER: gemini | openai | mock
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_ASSISTANT_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=40

# --- Chỉ khi deploy có HTTPS thật ---
# Bật khi chưa có SSL sẽ làm site không vào được.
USE_HTTPS=False

# --- Email ---
# Mặc định in email ra màn hình console (dùng khi dev/demo, không cần mạng).
# Trên host, điền thông tin SMTP để gửi mail thật.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=KMG Club <no-reply@kmgclub.local>
# Địa chỉ gốc để tạo link tuyệt đối trong email và mã QR chứng nhận
SITE_URL=http://127.0.0.1:8000

# --- Chuyển khoản VietQR (không bắt buộc) ---
# Điền đủ 3 biến BANK_BIN, BANK_ACCOUNT, BANK_ACCOUNT_NAME thì trang "Vé của tôi"
# hiện mã VietQR để người mua quét bằng app ngân hàng. Thiếu thì ẩn đi.
# BANK_BIN là mã NAPAS 6 số: Vietcombank 970436, VietinBank 970415,
# BIDV 970418, Techcombank 970407, MB 970422, ACB 970416, TPBank 970423.
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT=
# Tên chủ tài khoản: không dấu, IN HOA
BANK_ACCOUNT_NAME=
