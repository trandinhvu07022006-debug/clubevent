# Mẫu môi trường Kiểm thử Tiền phát hành (kmg_staging) dùng MySQL 8.4 + dịch vụ mock
# Lưu ý: khi phục vụ web/load test đặt DEBUG=False và ALLOW_DEMO_SEED=False;
# chỉ bật DEBUG=True ALLOW_DEMO_SEED=True trong lúc chạy `manage.py seed_staging`.
KMG_ENV=staging
DEBUG=False
ALLOW_DEMO_SEED=False

# Sinh từng khóa >= 32 ký tự độc lập trước khi chạy staging
SECRET_KEY=
CERT_SIGNING_KEY=
CHAT_MASTER_KEK=

DB_ENGINE=mysql
DB_NAME=kmg_staging
DB_USER=kmg
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
CACHE_URL=redis://127.0.0.1:6379/2

ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8080
USE_HTTPS=False

# Bắt buộc mock toàn bộ kênh ra ngoài trên staging
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SMS_PROVIDER=console
AI_PROVIDER=mock
AI_API_KEY=
SEPAY_API_KEY=
